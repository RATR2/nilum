type: custom
anchor: center

element panel:
    type: image
    image: ui_panel.png
    position: [0, 0]
    layer: 0

element title:
    type: text
    text: "Nilum example UI"
    font: default
    color: FFAA00
    position: [10, 10]
    layer: 2

element viewer_head:
    type: head
    player: client
    position: [10, 24]
    layer: 2

element viewer_name:
    type: text
    client_connector: text(name(client))
    font: default
    position: [22, 27]
    layer: 2

element confirm_button:
    type: button
    image: ui_confirm.png
    pressed: ui_confirm_pressed.png
    position: [20, 80]
    layer: 1
    action: send "&aConfirmed." to player

element cancel_button:
    type: button
    image: ui_cancel.png
    pressed: ui_cancel_pressed.png
    position: [130, 80]
    layer: 1
    action: send "&cCancelled." to player
